# ========== Security Settings ==========

# Only allow installations from official npm registry
registry=https://registry.npmjs.org/

# Require exact versions (no ^ or ~ in package.json)
save-exact=true

# Enable SSL verification
strict-ssl=true

# Block installation if lockfile doesn't match (CI/CD friendly)
frozen-lockfile=true

# Disable fetch retries to avoid hanging
fetch-retries=2

# ========== pnpm-Specific Settings ==========

# Use the standard lockfile format
lockfile=true

# Store packages globally (content-addressable storage)
store-dir=~/.pnpm-store

# Use symlinks instead of copying (pnpm's default)
node-linker=isolated

# Prevent pnpm from creating a nested node_modules structure for hoisting
# Helps avoid phantom dependencies
hoist=false

# ========== Script Safety ==========

# Block installation from running package scripts by default
# Next.js NEEDS some scripts to run (build, dev)
# This setting is better controlled via CLI: `pnpm install --ignore-scripts`
# or keep false and audit each package's scripts
ignore-scripts=false

# ========== Performance ==========

# Side-effects cache to speed up installs
side-effects-cache=true
side-effects-cache-readonly=true

# Use the faster catalog protocol (pnpm v8+)
use-catalog-protocol=false